# The service is intentionally loopback-only.
SIGNALDESK_HOST=127.0.0.1
SIGNALDESK_PORT=8765
SIGNALDESK_DATABASE=data/signaldesk.db
SIGNALDESK_TIMEZONE=Asia/Taipei

# rule (safe offline baseline), endpoint (OpenAI-compatible local endpoint), transformers
SIGNALDESK_MODEL_BACKEND=rule
SIGNALDESK_MODEL_ENDPOINT=http://127.0.0.1:8766/v1/chat/completions
SIGNALDESK_MODEL_ID=Qwen/Qwen3.5-4B

# Google Desktop OAuth file. Tokens are stored in the OS keyring, never here.
SIGNALDESK_GMAIL_CREDENTIALS=credentials.json
SIGNALDESK_GMAIL_DRAFT_SCOPE=0

# Optional official-account webhook connectors. Never commit real values.
SIGNALDESK_LINE_CHANNEL_SECRET=
SIGNALDESK_LINE_ACCOUNT_ID=line_official
SIGNALDESK_META_APP_SECRET=
SIGNALDESK_META_VERIFY_TOKEN=

# Set only for local demos. Never enabled automatically in production.
SIGNALDESK_DEMO=0
SIGNALDESK_RELOAD=0
