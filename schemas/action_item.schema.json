{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "owner",
    "supporting_span",
    "source_event_ids"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "supporting_span": {
      "type": "string",
      "minLength": 1
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deadline_ref": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "open",
        "done",
        "unknown"
      ]
    }
  }
}
