{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroupedThread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_id",
    "source",
    "event_ids",
    "content_completeness",
    "messages",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "thread_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sender": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content_completeness": {
      "enum": [
        "full",
        "thread_delta",
        "notification_preview",
        "metadata_only",
        "mixed"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "received_at",
          "content"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "sender": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "media_asset.schema.json"
            }
          }
        }
      }
    },
    "verified_memory": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
