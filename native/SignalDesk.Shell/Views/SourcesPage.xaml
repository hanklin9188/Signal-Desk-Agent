<UserControl
    x:Class="SignalDesk.Shell.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SignalDesk.Shell.Controls"
    xmlns:models="using:SignalDesk.Shell.Models">
    <ScrollViewer Background="Transparent">
        <StackPanel Padding="42,34,48,72" Spacing="20" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                <TextBlock Text="CONNECTORS" Style="{StaticResource SignalSectionLabelStyle}" Foreground="{StaticResource SignalAccentBrush}" />
                <TextBlock Text="訊息來源" Style="{StaticResource SignalPageTitleStyle}" />
                <TextBlock Text="Gmail 連線後每分鐘自動增量同步；個人聊天以封存建立歷史，再由 Windows 通知接續新訊息。"
                           Style="{StaticResource SignalBodySecondaryStyle}" MaxWidth="700" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="個人聊天同步檢查" Click="PersonalChatGuide_Click" />
                    <Button Content="OAuth 設定說明" Click="OAuthGuide_Click" />
                    <Button Content="新增 Gmail 帳號" Style="{StaticResource AccentButtonStyle}"
                            Click="AddGmail_Click" />
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind Connectors}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="2" Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectorItem">
                        <Border Style="{StaticResource SignalCardStyle}" Width="440" MinHeight="210" Margin="0,0,12,12"
                                Visibility="{x:Bind IsBusinessWebhook, Converter={StaticResource NotBoolVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ui:SourceBadge Source="{x:Bind BadgeSource}" BadgeSize="42" />
                                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SignalCardTitleStyle}" /><TextBlock Text="{x:Bind ConnectorId}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SignalChipStyle}"><TextBlock Text="{x:Bind StatusLabel}" FontSize="10" /></Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind DetailLabel}" Margin="0,16" Style="{StaticResource SignalBodySecondaryStyle}" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7">
                                    <Button Content="{x:Bind ConfigureLabel}" Tag="{x:Bind ConnectorId}" Click="Connect_Click" />
                                    <Button Content="立即同步" ToolTipService.ToolTip="背景每分鐘同步一次；按此可立刻檢查新郵件" Tag="{x:Bind ConnectorId}" Click="Sync_Click" Visibility="{x:Bind CanSync, Converter={StaticResource BoolVisibility}}" />
                                    <Button Content="中斷" Tag="{x:Bind ConnectorId}" Click="Disconnect_Click" Visibility="{x:Bind CanSync, Converter={StaticResource BoolVisibility}}" />
                                    <Button Content="移除" Tag="{x:Bind ConnectorId}" Click="Remove_Click" Visibility="{x:Bind IsGmail, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Success"
                     Title="個人 LINE／Messenger 不需要企業憑證"
                     Message="最新收到的個人訊息由 Windows 通知同步；下方 LINE Channel Secret 與 Meta Token 只供企業官方帳號／粉絲專頁使用。" />
            <StackPanel Spacing="10">
                <TextBlock Text="聊天記錄" Style="{StaticResource SignalCardTitleStyle}" />
                <TextBlock Text="封存檔只在這台電腦解析；重複匯入會自動去重，舊訊息不會觸發大量通知。"
                           Style="{StaticResource SignalBodySecondaryStyle}" />
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="個人聊天的同步範圍"
                         Message="LINE／Messenger 未提供個人帳號完整雙向同步 API。新收到的通知預覽會自動接在歷史後面；自己送出的訊息或未顯示預覽的內容，可重新匯出並在這裡增量更新，重複訊息會略過。" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SignalCardStyle}" MinHeight="180">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SourceBadge Source="line_notification" BadgeSize="42" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LINE 歷史聊天" Style="{StaticResource SignalCardTitleStyle}" />
                                    <TextBlock Text="官方「儲存聊天」.txt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="可一次選取多個聊天室文字檔；文字會保留時間、對話與傳送者。圖片、貼圖與語音只保留類型標記。"
                                       Style="{StaticResource SignalBodySecondaryStyle}" />
                            <Button x:Name="ImportLineButton" Grid.Row="2" Content="匯入／更新 LINE 封存…" Click="ImportLine_Click" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SignalCardStyle}" MinHeight="180">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ui:SourceBadge Source="messenger_notification" BadgeSize="42" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Messenger 歷史聊天" Style="{StaticResource SignalCardTitleStyle}" />
                                    <TextBlock Text="官方下載的 JSON／ZIP" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="支援 Accounts Center 下載資料與端對端加密聊天封存；訊息與附件類型會依原始時間整理。"
                                       Style="{StaticResource SignalBodySecondaryStyle}" />
                            <Button x:Name="ImportMessengerButton" Grid.Row="2" Content="匯入／更新 Messenger 封存…" Click="ImportMessenger_Click" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel x:Name="ImportProgressPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="18" Height="18" />
                    <TextBlock x:Name="ImportProgressText" Text="正在本機解析與整理聊天記錄…" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <Expander Header="企業 webhook 整合（選用；個人帳號不需要）" IsExpanded="False">
                <StackPanel Spacing="12" Padding="0,10,0,4">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="只在你經營官方帳號或粉絲專頁時設定"
                             Message="企業 webhook 只能收到使用者傳給該官方帳號／粉絲專頁的訊息，不能讀取你的個人 LINE 或 Messenger 對話。" />
                    <ItemsControl ItemsSource="{x:Bind Connectors}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="2" Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ConnectorItem">
                                <Border Style="{StaticResource SignalCardStyle}" Width="440" MinHeight="180" Margin="0,0,12,12"
                                        Visibility="{x:Bind IsBusinessWebhook, Converter={StaticResource BoolVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ui:SourceBadge Source="{x:Bind BadgeSource}" BadgeSize="42" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SignalCardTitleStyle}" />
                                                <TextBlock Text="{x:Bind ConnectorId}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource SignalChipStyle}"><TextBlock Text="{x:Bind StatusLabel}" FontSize="10" /></Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind DetailLabel}" Margin="0,16" Style="{StaticResource SignalBodySecondaryStyle}" />
                                        <Button Grid.Row="2" Content="{x:Bind ConfigureLabel}" Tag="{x:Bind ConnectorId}" Click="Connect_Click" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="來源完整度是安全邊界"
                         Message="封存提供既有文字歷史；通知提供之後的新訊息。未出現在封存或通知預覽中的內容不會被猜測。" />
                <InfoBar Grid.Column="1" IsOpen="True" IsClosable="False" Severity="Success" Title="Gmail 只使用官方 OAuth"
                         Message="SignalDesk 不接受或保存 Gmail 密碼。不同帳號必須各自在 Google 網頁完成一次授權。" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
