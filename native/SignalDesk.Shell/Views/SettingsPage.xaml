<UserControl
    x:Class="SignalDesk.Shell.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="Transparent">
        <StackPanel Padding="42,34,48,78" Spacing="20" MaxWidth="1020" HorizontalAlignment="Center">
            <StackPanel Spacing="3">
                <TextBlock Text="PREFERENCES" Style="{StaticResource SignalSectionLabelStyle}"
                           Foreground="{StaticResource SignalAccentBrush}" />
                <TextBlock Text="設定" Style="{StaticResource SignalPageTitleStyle}" />
                <TextBlock Text="調整打斷方式、摘要時間、本機模型與資料保存。所有偏好都只儲存在這台電腦。"
                           Style="{StaticResource SignalBodySecondaryStyle}" />
            </StackPanel>

            <Border Style="{StaticResource SignalHeroCardStyle}">
                <StackPanel Spacing="15">
                    <Grid><StackPanel Spacing="2"><TextBlock Text="ATTENTION" Style="{StaticResource SignalSectionLabelStyle}" Foreground="{StaticResource SignalAccentBrush}" /><TextBlock Text="注意力與提醒" Style="{StaticResource SignalCardTitleStyle}" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SignalChipStyle}"><TextBlock Text="可隨時調整" FontSize="10" /></Border></Grid>
                    <ToggleSwitch x:Name="FocusModeToggle" Header="專注模式"
                                  OffContent="即時顯示安全範圍內的重要通知" OnContent="累積後以摘要呈現" />
                    <ToggleSwitch x:Name="ShadowModeToggle" Header="Shadow Mode"
                                  OffContent="依決策顯示提醒" OnContent="只觀察與記錄決策，不主動打斷" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TimePicker x:Name="QuietStartPicker" Header="勿擾開始" ClockIdentifier="24HourClock" />
                        <TimePicker x:Name="QuietEndPicker" Grid.Column="1" Header="勿擾結束" ClockIdentifier="24HourClock" />
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TimePicker x:Name="DigestTimePicker" Header="每日 Digest" ClockIdentifier="24HourClock" />
                        <NumberBox x:Name="FocusDigestBox" Grid.Column="1" Header="專注模式摘要間隔（分鐘）"
                                   Minimum="15" Maximum="240" SpinButtonPlacementMode="Compact" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SignalCardStyle}">
                <StackPanel Spacing="15">
                    <TextBlock Text="桌面體驗" Style="{StaticResource SignalCardTitleStyle}" />
                    <ComboBox x:Name="ThemeCombo" Header="外觀" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="跟隨 Windows" Tag="system" />
                        <ComboBoxItem Content="淺色" Tag="light" />
                        <ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                    <ToggleSwitch x:Name="StartupToggle" Header="登入 Windows 時啟動 SignalDesk"
                                  Toggled="StartupToggle_Toggled" />
                    <TextBlock x:Name="StartupStatusText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SignalCardStyle}">
                <StackPanel Spacing="15">
                    <TextBlock Text="本機模型與資料" Style="{StaticResource SignalCardTitleStyle}" />
                    <ComboBox x:Name="ModelResidencyCombo" Header="模型駐留策略" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="常駐 GPU（反應最快）" Tag="always_on" />
                        <ComboBoxItem Content="需要時載入（較省資源）" Tag="on_demand" />
                        <ComboBoxItem Content="遊戲／訓練時自動休眠" Tag="auto_sleep" />
                    </ComboBox>
                    <TextBox x:Name="AllowlistBox" Header="允許擷取通知的 App"
                             Description="用逗號分隔，例如 LINE, Messenger, Google Chrome。未列入的通知不會進入 SignalDesk。"
                             TextWrapping="Wrap" />
                    <NumberBox x:Name="RetentionDaysBox" Header="原始內容保存天數"
                               Minimum="1" Maximum="90" SpinButtonPlacementMode="Compact" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="本機優先"
                             Message="分類、摘要、偏好學習與稽核記錄都在本機完成；不會把私人訊息傳給雲端模型。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SignalCardStyle}">
                <StackPanel Spacing="13">
                    <TextBlock Text="隱私與資料控制" Style="{StaticResource SignalCardTitleStyle}" />
                    <TextBlock Text="匯出一份可讀 JSON 備份，或清除 SignalDesk 儲存的私人訊息、卡片與偏好。"
                               Style="{StaticResource SignalBodySecondaryStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="匯出我的資料" Click="Export_Click" />
                        <Button Content="重設個人化學習" Click="ResetPersonalization_Click" />
                        <Button Content="清除私人資料" Click="DeleteData_Click"
                                Foreground="{StaticResource SignalRedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="儲存設定" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right" Padding="24,10" Click="Save_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
