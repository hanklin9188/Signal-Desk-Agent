<Application
    x:Class="SignalDesk.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:SignalDesk.Shell.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <services:BoolToVisibilityConverter x:Key="BoolVisibility" />
            <services:NotBoolToVisibilityConverter x:Key="NotBoolVisibility" />
            <services:CollectionToVisibilityConverter x:Key="CollectionVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
