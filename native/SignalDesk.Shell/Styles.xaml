<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SignalPageBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="SignalTopBarBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="SignalPaneBrush" Color="#F7F9FC" />
            <SolidColorBrush x:Key="SignalInsetBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="SignalCardBrush" Color="#FCFDFE" />
            <SolidColorBrush x:Key="SignalCardHoverBrush" Color="#F4F2FF" />
            <SolidColorBrush x:Key="SignalCardStrokeBrush" Color="#DDE3EB" />
            <SolidColorBrush x:Key="SignalHeroBrush" Color="#F0EEFF" />
            <SolidColorBrush x:Key="SignalHeroStrokeBrush" Color="#D8D3FF" />
            <SolidColorBrush x:Key="SignalMutedBrush" Color="#677184" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SignalPageBrush" Color="#0E121A" />
            <SolidColorBrush x:Key="SignalTopBarBrush" Color="#111620" />
            <SolidColorBrush x:Key="SignalPaneBrush" Color="#111722" />
            <SolidColorBrush x:Key="SignalInsetBrush" Color="#151C28" />
            <SolidColorBrush x:Key="SignalCardBrush" Color="#19212E" />
            <SolidColorBrush x:Key="SignalCardHoverBrush" Color="#222B3A" />
            <SolidColorBrush x:Key="SignalCardStrokeBrush" Color="#293446" />
            <SolidColorBrush x:Key="SignalHeroBrush" Color="#201E38" />
            <SolidColorBrush x:Key="SignalHeroStrokeBrush" Color="#3D3969" />
            <SolidColorBrush x:Key="SignalMutedBrush" Color="#9AA6B8" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="SignalAccentBrush" Color="#7770F2" />
    <SolidColorBrush x:Key="SignalAccentSoftBrush" Color="#247770F2" />
    <SolidColorBrush x:Key="SignalCyanBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SignalGreenBrush" Color="#25B889" />
    <SolidColorBrush x:Key="SignalGreenSoftBrush" Color="#1D25B889" />
    <SolidColorBrush x:Key="SignalAmberBrush" Color="#E3A53A" />
    <SolidColorBrush x:Key="SignalAmberSoftBrush" Color="#20E3A53A" />
    <SolidColorBrush x:Key="SignalRedBrush" Color="#EC6670" />
    <SolidColorBrush x:Key="SignalRedSoftBrush" Color="#1DEC6670" />

    <Style x:Key="SignalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SignalCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SignalCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SignalHeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SignalHeroBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SignalHeroStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <Style x:Key="SignalSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SignalChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SignalCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SignalCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style x:Key="SignalPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SignalMetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SignalCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SignalBodySecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SignalIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SignalCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SignalCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SignalListCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SignalCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SignalCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="14" />
    </Style>
</ResourceDictionary>
