<Window
    x:Class="SignalDesk.Shell.OrbWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SignalDesk Orb">
    <Grid Background="Transparent" PointerPressed="DragSurface_PointerPressed">
        <Button x:Name="OpenButton" Width="50" Height="50" Padding="0" CornerRadius="17"
                Click="OpenButton_Click" ToolTipService.ToolTip="查看 SignalDesk Glance">
            <Grid>
                <Ellipse>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.35,0.22" GradientOrigin="0.35,0.22">
                            <GradientStop Color="#B7A1FF" Offset="0" />
                            <GradientStop Color="#625ED7" Offset="0.58" />
                            <GradientStop Color="#3A3F9C" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="S" Foreground="White" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="CountBadge" MinWidth="18" Height="18" Padding="4,0"
                        CornerRadius="9" Background="#D9364F"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock x:Name="CountText" Text="0" Foreground="White" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>
    </Grid>
</Window>
